# URL pública del sitio (canonical, Open Graph y sitemap).
VITE_SITE_URL=https://emmporiojuridico.com

# Punto único de integración de los formularios: a esta URL llegan tanto las
# consultas del formulario de contacto como las suscripciones del boletín.
# Si se deja vacío, el envío se simula en consola y no sale ninguna petición.
#
# Opción recomendada — Web3Forms (gratis, 250 envíos al mes, sin backend):
#   1. Entre a https://web3forms.com y pida la clave con el correo de la firma.
#   2. Le llega una «Access Key» por correo.
#   3. Pegue las dos líneas de abajo con esa clave.
#
#   VITE_LEAD_ENDPOINT=https://api.web3forms.com/submit
#   VITE_LEAD_ACCESS_KEY=la-clave-que-le-enviaron
#
# Las consultas llegan al correo con el que pidió la clave.
VITE_LEAD_ENDPOINT=

# Solo para servicios que identifican la cuenta con una clave en el envío
# (Web3Forms). Con un webhook propio o n8n se deja vacío.
VITE_LEAD_ACCESS_KEY=
