{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.emmporiojuridico.com"
        }
      ],
      "destination": "https://emmporiojuridico.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "emmporio.vercel.app"
        }
      ],
      "destination": "https://emmporiojuridico.com/:path*",
      "permanent": true
    }
  ]
}
